# PostgreSQL (with pgvector extension enabled)
DATABASE_URL=postgresql://user:password@host:5432/landplanr

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# API server (kept off :3000 since the Next.js dev server also defaults to it)
PORT=4000

# development | production — must be exactly "production" on any real
# deployment. Some dev-only conveniences key off this (e.g. POST /users/invite
# only echoes the raw invite token back in the response when this is
# "development" — there's no email-sending yet to deliver it otherwise).
NODE_ENV=development

# Cloudflare R2 (S3-compatible). Endpoint is account-level, no bucket path —
# the bucket is passed separately on every request.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=landplanr-documents
R2_ACCESS_KEY_ID=replace-with-a-real-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-a-real-secret-access-key

# Redis (BullMQ ingestion queue). Use the full connection URL, including
# credentials/TLS if your provider requires them (e.g. Upstash, Redis Cloud).
REDIS_URL=redis://localhost:6379

# OpenAI — used for BOTH embeddings (text-embedding-3-small, step 7, plain
# HTTP per CLAUDE.md section 17) AND, temporarily, chat answer generation
# (see CHAT_PROVIDER below and decisions.md) while Anthropic billing isn't
# set up yet.
OPENAI_API_KEY=replace-with-a-real-openai-api-key
# Budget tier — a handful of already-matched chunks with inline citations
# doesn't need the flagship model. Only used when CHAT_PROVIDER=openai.
OPENAI_CHAT_MODEL=gpt-4o-mini

# Chat answer generation is provider-pluggable (ChatProvider interface,
# apps/api/src/chat/providers/) — 'anthropic' | 'openai'. CLAUDE.md section
# 6/19 designates Claude as the target; 'openai' is a temporary, explicitly
# approved substitute (see decisions.md) until ANTHROPIC billing exists.
# Switching back later is just flipping this value once ANTHROPIC_API_KEY
# is set — no code changes.
CHAT_PROVIDER=openai

# Anthropic (Claude — via the official Node SDK). Model is overridable;
# defaults to claude-haiku-4-5-20251001 — same reasoning as OPENAI_CHAT_MODEL
# above. Only used when CHAT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=replace-with-a-real-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# If the selected provider's API key is missing, chat-provider-selector.ts
# automatically falls back to a clearly-labeled MOCK response (a warning is
# logged every time) so the rest of the chat pipeline can be built/tested
# without a real key. Retrieval (the four-way scope filter + pgvector
# search) is NEVER mocked — only the final "send to the provider" call is.
# Set USE_MOCK_CHAT=true to force mock mode even with a real key present
# (e.g. to avoid burning API credits in a specific dev session).
USE_MOCK_CHAT=false
