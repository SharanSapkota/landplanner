# PostgreSQL (with pgvector extension enabled)
DATABASE_URL=postgresql://user:password@host:5432/landplanr

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# API server (kept off :3000 since the Next.js dev server also defaults to it)
PORT=4000

# development | production — must be exactly "production" on any real
# deployment. Some dev-only conveniences key off this (e.g. POST /users/invite
# only echoes the raw invite token back in the response when this is
# "development" — there's no email-sending yet to deliver it otherwise).
NODE_ENV=development

# Cloudflare R2 (S3-compatible). Endpoint is account-level, no bucket path —
# the bucket is passed separately on every request.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=landplanr-documents
R2_ACCESS_KEY_ID=replace-with-a-real-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-a-real-secret-access-key

# Redis (BullMQ ingestion queue). Use the full connection URL, including
# credentials/TLS if your provider requires them (e.g. Upstash, Redis Cloud).
REDIS_URL=redis://localhost:6379

# OpenAI (embeddings only — text-embedding-3-small, called via plain HTTP
# per CLAUDE.md section 17, no SDK).
OPENAI_API_KEY=replace-with-a-real-openai-api-key

# Anthropic (Claude — answer generation, via the official Node SDK per
# CLAUDE.md section 6/19). Model is overridable; defaults to claude-sonnet-5.
# If ANTHROPIC_API_KEY is left unset, claude.service.ts automatically falls
# back to a clearly-labeled MOCK response (a warning is logged every time) so
# the rest of the chat pipeline can be built/tested without a real key.
# Retrieval (the four-way scope filter + pgvector search) is NEVER mocked —
# only this final "send to Claude" call is. Set USE_MOCK_CLAUDE=true to force
# mock mode even with a real key present (e.g. to avoid burning API credits
# in a specific dev session).
ANTHROPIC_API_KEY=replace-with-a-real-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5
USE_MOCK_CLAUDE=false
